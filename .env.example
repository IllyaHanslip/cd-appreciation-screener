# Copy this file to .env and fill it in. Never commit .env.

# Personal access token: https://www.discogs.com/settings/developers
# Leave empty to use the built-in simulated market (offline demo).
DISCOGS_TOKEN=

# Discogs asks every client for a descriptive User-Agent with contact details.
DISCOGS_USER_AGENT=CDAppreciationScreener/1.0 (+mailto:you@example.com)

# Optional: use a different SQLite file (default: data/cd_screener.db).
# CD_SCREENER_DB=C:\path\to\cd_screener.db
